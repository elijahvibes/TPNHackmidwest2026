# Copy to .env and fill in what you have. Everything is optional except
# DATABASE_URL, JWT_SECRET and SERPAPI_KEY (required for trip planning).

PORT=8080
# MySQL. Local dev (scripts/dev-db.ps1 or `docker compose --profile local up -d db`):
DATABASE_URL=mysql://trailmix:trailmix@localhost:3306/trailmix
# Akamai (Linode) Managed MySQL — paste the connection string from the Linode
# console exactly as shown (mysql://user:pass@host:port/defaultdb?ssl-mode=REQUIRED).
# The "private-" host only resolves from inside Akamai (use it on the Linode).
# Add the Linode's IP to the database's Access Controls or connections are refused.
# DATABASE_URL=mysql://<user>:<password>@private-<id>.g2a.akamaidb.net:<port>/defaultdb?ssl-mode=REQUIRED
# CA for verifying the managed database's certificate (deploy/akamai-db-ca.crt is
# found automatically; the Docker image bakes it in). Without it TLS is still on,
# just unverified.
# DATABASE_CA_CERT=deploy/akamai-db-ca.crt
JWT_SECRET=change-me-to-a-long-random-string
# Dev only; leave empty in prod (same origin). Comma-separate multiple origins.
CORS_ORIGIN=http://localhost:5173
# Public hostname Caddy serves over HTTPS on the Linode. Default is the sslip.io
# name for the server IP (no DNS needed). Point a real domain's A record at the
# Linode and put it here to use it instead.
SITE_HOST=172-239-49-30.sslip.io

# --- AI on Akamai (any OpenAI-compatible chat completions endpoint) ---
# Akamai Inference Cloud example:  https://<your-endpoint>/v1
# Ollama on a Linode GPU box:      http://<linode-ip>:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=llama-3.1-8b-instruct

# --- Travel data (all have free tiers) ---
# https://serpapi.com/manage-api-key (Google Flights + Google Hotels)
# Required: missing keys and failed searches return errors, never mock quotes.
SERPAPI_KEY=
# https://www.eia.gov/opendata/   (weekly US gas price)
EIA_KEY=
# https://console.cloud.google.com (Places API New)
GOOGLE_PLACES_KEY=
# Free Geoapify Places alternative; takes priority over Google when configured.
GEOAPIFY_KEY=
# https://account.mapbox.com      (geocoding + directions; also used by the map UI)
MAPBOX_TOKEN=

